{
  "name": "ssrgenerate",
  "private": true,
  "type": "module",
  "scripts": {
    "build:typo": "python scripts/render_typography.py",
    "build:optics": "python scripts/render_optics.py",
    "build:material": "python scripts/render_material.py",
    "build:se": "python scripts/generate_se.py",
    "build:assets": "python scripts/build_all.py",
    "dev": "npx --yes hyperframes@0.9.72 preview",
